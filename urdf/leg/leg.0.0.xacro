<?xml version="1.0"?>
<robot name="quaro-leg" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="effor" value="1.47"/>
  <xacro:property name="zero" value="0.0"/>
  <xacro:property name="velocity" value="0.1"/>

  

  <xacro:macro name="leg" params="n xyz rpy parent rot">

  <!-- Leg Joint 1 -->
  <joint name="hip_${n}" type="revolute">
    <parent link="${parent}"/>
    <child link="leg${n}_link1"/>
    <origin xyz="${xyz}" rpy="${rpy}"/>
    <axis xyz="0 0 ${rot}"/>
    <limit effort="100.0" velocity="1.0" lower="-${2*pi/3}" upper="${2*pi/3}"/>
  </joint>

  <link name="leg${n}_link1">
    <visual>
      <geometry>
        <mesh filename="package://quaro_description/meshes/hip_assembly.stl" scale="${scale} ${scale} ${scale}"/>  
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      </geometry>
    </visual>
  </link>

  <!-- Leg Joint 2 -->
  <joint name="knee_${n}" type="revolute">
    <parent link="leg${n}_link1"/>
    <child link="leg${n}_link2"/>
    <origin xyz="${scale*40} ${scale*0} ${scale*28.3}" rpy="-${pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100.0" velocity="1.0" lower="-${2*pi/3}" upper="${2*pi/3}"/>
  </joint>

  <link name="leg${n}_link2">
    <visual>
      <geometry>
        <mesh filename="package://quaro_description/meshes/knee_assembly.stl" scale="${scale} ${scale} ${scale}"/>  
      </geometry>
      <origin xyz="${scale*10} ${scale*0} ${scale*0}" rpy="${pi/2} 0 ${pi}"/>
      <material name="blue"/>
    </visual>
  </link>

  <!-- Leg Joint 3 -->
  <joint name="ankle_${n}" type="revolute">
    <parent link="leg${n}_link2"/>
    <child link="leg${n}_link3"/>
    <origin xyz="${scale*53.9} ${scale*15} ${scale*0}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100.0" velocity="1.0" lower="-${2*pi/3}" upper="${2*pi/3}"/>
  </joint>

  <link name="leg${n}_link3">
    <visual>
      <geometry>
        <mesh filename="package://quaro_description/meshes/foot_assembly.stl" scale="${scale} ${scale} ${scale}"/>  
      </geometry>
      <origin xyz="${scale*10} ${scale*0} ${scale*0}" rpy="-${pi/2} 0 ${pi}"/>
      <material name="green"/>
    </visual>
  </link>

  </xacro:macro>
</robot>

