<?xml version="1.0"?>
<robot name="quaro" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Various constant definitions -->
  <xacro:include filename='$(find quaro_description)/urdf/common/constants.xacro'/>
  <!-- Servo visual -->
  <xacro:include filename="$(find quaro_description)/urdf/common/lx-224hv.xacro"/>
  <!-- Material Colors -->
  <xacro:include filename="$(find quaro_description)/urdf/common/colors.xacro"/>
  <!-- Leg macro -->
  <xacro:include filename="$(find quaro_description)/urdf/leg/leg.0.0.xacro"/>
  <!-- Import quaro ros2_control description -->
  <xacro:include filename="$(find quaro_hardware_interface)/ros2_control/hardware_interface.ros2_control.xacro"/>
  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.2"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
    </visual>
  </link>

  <!-- Chain A -->
  <xacro:leg n="0" parent="base_link" xyz="0.1 -0.05 0.0" rpy="${pi} 0 ${pi/4}"/>
  <!-- Chain B -->
  <xacro:leg n="1" parent="base_link" xyz="0.1 0.05 0.0" rpy="${pi} 0 ${3*pi/4}"/>
  <!-- Chain B -->
  <xacro:leg n="2" parent="base_link" xyz="-0.1 -0.05 0.0" rpy="${pi} 0 -${pi/4}"/>
  <!-- Chain B -->
  <xacro:leg n="3" parent="base_link" xyz="-0.1 0.05 0.0" rpy="${pi} 0 -${3*pi/4}"/>

  <xacro:quaro_ros2_control/>
</robot>
